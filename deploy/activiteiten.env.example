# /etc/activiteiten.env  (alleen leesbaar voor root en de service)
# Garmin-sleutel: bij voorkeur invullen in de app (Instellingen). Hier mag ook; de app gaat voor.
GARMIN_API_KEY=
# Inlog voor de webpagina. Leeg wachtwoord = geen inlog (alleen doen op een afgeschermd netwerk).
APP_USER=bjorn
APP_PASSWORD=
PORT=8080
TZ=Europe/Amsterdam
DATA_DIR=/var/lib/activiteiten
